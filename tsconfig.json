{
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "esnext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["node"],
		"jsx": "preserve",
		"plugins": [
			{
				"name": "next"
			}
		],
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"incremental": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"checkJs": true,
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"noEmit": true
	},
	"include": ["**/*"],
	"exclude": ["**/node_modules", "**/.history"]
}
