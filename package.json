{
	"name": "homes-tracker",
	"version": "0.1.43",
	"private": true,
	"packageManager": "pnpm@9.8.0",
	"type": "module",
	"scripts": {
		"web:dev": "pnpm --filter=@/web dev",
		"bot:start": "dotenv -c -- pnpm --filter=@/bot start",
		"lint": "eslint --max-warnings=0",
		"lint-staged": "lint-staged",
		"typecheck": "pnpm -r typecheck",
		"format": "prettier --write '**/*.{js,jsx,ts,tsx,json,css}'",
		"format:verify": "prettier --check '**/*.{js,jsx,ts,tsx,json,css}'",
		"docker": "pnpm --filter @/scripts docker"
	},
	"devDependencies": {
		"@eslint/compat": "^1.1.1",
		"@eslint/eslintrc": "^3.1.0",
		"@eslint/js": "^9.9.0",
		"@types/eslint__js": "^8.42.3",
		"@types/node": "^22.5.0",
		"@typescript-eslint/eslint-plugin": "^8.1.0",
		"@typescript-eslint/parser": "^8.1.0",
		"dotenv-cli": "^7.4.2",
		"eslint": "9.9.1",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-airbnb-typescript": "^18.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.6.1",
		"eslint-plugin-deprecation": "^3.0.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-react": "^7.35.0",
		"eslint-plugin-react-hooks": "^4.6.2",
		"globals": "^15.9.0",
		"lint-staged": "^15.2.9",
		"pre-commit": "^1.2.2",
		"prettier": "^3.3.3",
		"typescript": "^5.5.4",
		"typescript-eslint": "^8.2.0"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"eslint": "9",
				"eslint-config-airbnb-typescript>@typescript-eslint/eslint-plugin": "8",
				"eslint-config-airbnb-typescript>@typescript-eslint/parser": "8",
				"next": "19.0.0-rc-fb9a90fa48-20240614"
			}
		}
	},
	"pre-commit": [
		"typecheck",
		"lint-staged"
	],
	"lint-staged": {
		"*.{j,t}s{,x}": [
			"prettier --write",
			"eslint --fix"
		]
	}
}
