{
  "name": "homes-tracker",
  "version": "0.1.43",
  "private": true,
  "packageManager": "pnpm@9.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t homes-tracker .",
    "docker:tag": "docker tag homes-tracker:latest $DOCKER_PREFIX/homes-tracker:$(node -p -e \"require('./package.json').version\")",
    "docker:publish": "pnpm run docker:tag && docker push $DOCKER_PREFIX/homes-tracker:$(node -p -e \"require('./package.json').version\")",
    "update:patch": "pnpm version --no-git-tag-version patch",
    "bot:run": "tsx bot/index.ts",
    "bot:docker:build": "docker build -t homes-tracker-bot -f bot/Dockerfile .",
    "bot:docker:tag": "docker tag homes-tracker-bot:latest $DOCKER_PREFIX/homes-tracker-bot:$(node -p -e \"require('./package.json').version\")",
    "bot:docker:publish": "pnpm run bot:docker:tag && docker push $DOCKER_PREFIX/homes-tracker-bot:$(node -p -e \"require('./package.json').version\")"
  },
  "dependencies": {
    "@sindresorhus/transliterate": "^1.6.0",
    "@stitches/react": "^1.2.8",
    "@turf/boolean-point-in-polygon": "^7.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "mongodb": "^6.8.0",
    "next": "^15.0.0-rc.0",
    "node-telegram-bot-api": "^0.66.0",
    "queue-promise": "^2.2.1",
    "react": "^19.0.0-beta-26f2496093-20240514",
    "react-dom": "^19.0.0-beta-26f2496093-20240514",
    "@tanstack/react-query": "^5.52.1",
    "tsx": "^4.18.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.5.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/react": "npm:types-react@rc",
    "@types/react-dom": "npm:types-react-dom@rc",
    "eslint": "9.9.1",
    "typescript": "^5.5.4",
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-react": "^7.35.0",
    "typescript-eslint": "^8.2.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-react-hooks": "^4.6.2"
  },
  "overrides": {
    "@types/react": "npm:types-react@rc",
    "@types/react-dom": "npm:types-react-dom@rc"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9",
        "eslint-config-airbnb-typescript>@typescript-eslint/eslint-plugin": "8",
        "eslint-config-airbnb-typescript>@typescript-eslint/parser": "8",
        "next": "19.0.0-rc-fb9a90fa48-20240614"
      }
    }
  }
}
