{
  "name": "homes-tracker",
  "version": "0.1.43",
  "private": true,
  "packageManager": "pnpm@9.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:build": "docker build -t homes-tracker .",
    "docker:tag": "docker tag homes-tracker:latest $DOCKER_PREFIX/homes-tracker:$(node -p -e \"require('./package.json').version\")",
    "docker:publish": "pnpm run docker:tag && docker push $DOCKER_PREFIX/homes-tracker:$(node -p -e \"require('./package.json').version\")",
    "update:patch": "pnpm version --no-git-tag-version patch",
    "bot:dev": "nodemon bot/index.ts",
    "bot:prod": "tsx bot/index.ts",
    "bot:docker:build": "docker build -t homes-tracker-bot -f bot/Dockerfile .",
    "bot:docker:tag": "docker tag homes-tracker-bot:latest $DOCKER_PREFIX/homes-tracker-bot:$(node -p -e \"require('./package.json').version\")",
    "bot:docker:publish": "pnpm run bot:docker:tag && docker push $DOCKER_PREFIX/homes-tracker-bot:$(node -p -e \"require('./package.json').version\")"
  },
  "dependencies": {
    "@sindresorhus/transliterate": "^1.6.0",
    "@stitches/react": "^1.2.7",
    "@turf/boolean-point-in-polygon": "^6.5.0",
    "aws-sdk": "^2.1100.0",
    "axios": "^0.26.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.0.0",
    "forever": "^4.0.3",
    "mongodb": "^4.4.1",
    "next": "12.1.0",
    "node-telegram-bot-api": "^0.56.0",
    "queue-promise": "^2.2.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-query": "^3.34.19",
    "tsx": "^4.18.0",
    "winston": "^3.6.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.8",
    "@types/node": "17.0.23",
    "@types/node-telegram-bot-api": "^0.56.0",
    "@types/react": "17.0.43",
    "eslint": "8.11.0",
    "eslint-config-next": "12.1.0",
    "nodemon": "^2.0.15",
    "typescript": "4.6.3"
  }
}
