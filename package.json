{
	"name": "homes-tracker",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"type": "module",
	"scripts": {
		"bot:start": "dotenv -c -- bun run --cwd apps/bot start",
		"format": "oxfmt --write",
		"format:verify": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint-staged": "lint-staged",
		"typecheck": "bun check",
		"web:dev": "dotenv -c -- bun run --cwd apps/web dev"
	},
	"devDependencies": {
		"@luixo/configs": "^0.1.0",
		"@types/node": "^22.5.0",
		"dotenv-cli": "^7.4.2",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"pre-commit": "^2.0.0",
		"typescript": "^5.5.4"
	},
	"overrides": {
		"@types/react": "npm:types-react@rc",
		"@types/react-dom": "npm:types-react-dom@rc"
	},
	"lint-staged": {
		"*.{j,t}s{,x}": "oxlint --fix"
	},
	"pre-commit": [
		"typecheck",
		"format",
		"lint-staged"
	],
	"engines": {
		"node": "26"
	},
	"packageManager": "bun@1.4.3",
	"patchedDependencies": {
		"@mapbox/mapbox-gl-draw@1.4.3": "patches/@mapbox__mapbox-gl-draw.patch",
		"@nextui-org/listbox@2.1.25": "patches/@nextui-org__listbox.patch",
		"@trpc/react-query@11.0.0-rc.490": "patches/@trpc__react-query.patch",
		"mapbox-gl-draw-freehand-mode@2.1.0": "patches/mapbox-gl-draw-freehand-mode.patch",
		"react-icons@5.3.0": "patches/react-icons.patch"
	},
	"trustedDependencies": [
		"pre-commit"
	]
}
