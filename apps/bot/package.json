{
	"name": "@/bot",
	"version": "0.2.9",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./dist/src/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"docker:all": "docker buildx build -f ./Dockerfile -t ${DOCKER_PREFIX}/homes-tracker-bot:$(bun -p 'require(\"./package.json\").version') --platform linux/amd64 --push ../..",
		"start": "tsx src/index.ts",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@/db": "workspace:*",
		"@/intercom": "workspace:*",
		"@/server": "workspace:*",
		"@/telegram": "workspace:*",
		"@/types": "workspace:*",
		"@/utils": "workspace:*",
		"@trpc/server": "11.0.0-rc.490",
		"node-telegram-bot-api": "^0.66.0",
		"tsx": "^4.18.0"
	},
	"devDependencies": {
		"@types/node-telegram-bot-api": "^0.64.7"
	}
}
