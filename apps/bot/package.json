{
	"name": "@/bot",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./dist/src/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@/db": "workspace:*",
		"@/filters": "workspace:*",
		"@/intercom": "workspace:*",
		"@/tsconfig": "workspace:*",
		"@/utils": "workspace:*",
		"node-telegram-bot-api": "^0.66.0",
		"tsx": "^4.18.0"
	},
	"devDependencies": {
		"@types/node-telegram-bot-api": "^0.64.7"
	},
	"dockerImage": "homes-tracker-bot"
}
